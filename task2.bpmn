    <bpmn:sequenceFlow id="Flow_5" name="нет" sourceRef="Gateway_1" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_6" name="да" sourceRef="Gateway_1" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_7" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_6" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_11" name="да" sourceRef="Gateway_2" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_12" name="нет" sourceRef="Gateway_2" targetRef="Task_4" />
  </bpmn:process>
